
# ==========================================
# Nexora Corporate Platform - Backend Environment Variables
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="NextGen Corporate Platform - Enquiry Management API"

# Allowed CORS Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database Connection
# Replace with your actual local or Supabase database connection string.
DATABASE_URL="postgresql://postgres:your-local-password@localhost:5432/postgres?sslmode=prefer"

# Supabase Auth & JWT Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_JWT_ALGORITHM="HS256"

# LLM / AI Configuration
# Supported providers: openai, anthropic, groq, mock, custom_openai_compatible
LLM_PROVIDER="mock"
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="your-llm-model"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2

# n8n Automation Webhooks
N8N_EMAIL_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/nexora-stage-email"
N8N_WEBHOOK_SECRET="your-n8n-webhook-secret"
